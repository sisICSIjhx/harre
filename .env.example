# Públicas: se incorporan al frontend compilado
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# "sharepoint" envía los archivos del expediente a SharePoint; vacío los deja en Supabase Storage
VITE_EMPLOYEE_FILES_TARGET=

# Privadas: solo Vercel Functions
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SYNC_JOB_SECRET=

# Autenticación de servicio en Microsoft Entra ID
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Archivo SharePoint ya provisionado
SP_SITE_ID=
SP_DRIVE_ID=
SP_FILE_ITEM_ID=
# Carpeta del mismo drive donde se crean las carpetas de expediente
SP_EMPLOYEES_FOLDER_ID=

# Configuración del procesador
SYNC_ENABLED=false
SYNC_TARGET=personal-icsi
